<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
  <modelVersion>4.0.0</modelVersion>

  <groupId>codes.castled.gpexpansion</groupId>
  <artifactId>gpexpansion</artifactId>
  <version>1.2.5</version>
  <name>GPExpansion</name>
  <description>GriefPrevention Expansion</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      Claim waypoints need a Paper API >= 1.21.11: LivingEntity#setWaypointStyle and
      #setWaypointColor landed after 1.21.6, and Attribute.WAYPOINT_TRANSMIT_RANGE in 1.21.6.
    -->
    <paper.version>26.2.build.40-alpha</paper.version>
    <spigot.version>1.21.4-R0.1-SNAPSHOT</spigot.version>
    <server.api.group>io.papermc.paper</server.api.group>
    <server.api.artifact>paper-api</server.api.artifact>
    <server.api.version>${paper.version}</server.api.version>
    <adventure.minimessage.version>5.2.0</adventure.minimessage.version>
    <vault.api.version>1.7</vault.api.version>
    <griefprevention3d.version>18.2.7</griefprevention3d.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc-repo</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>sonatype</id>
      <url>https://oss.sonatype.org/content/groups/public/</url>
    </repository>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
    <repository>
      <id>codemc-releases</id>
      <url>https://repo.codemc.io/repository/maven-releases/</url>
    </repository>
    <repository>
      <id>codemc-snapshots</id>
      <url>https://repo.codemc.io/repository/maven-snapshots/</url>
    </repository>
    <repository>
      <id>codemc-nms</id>
      <url>https://repo.codemc.io/repository/nms/</url>
    </repository>
    <repository>
      <id>placeholderapi</id>
      <url
            >https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
    </repository>
    <repository>
      <id>bluecolored-releases</id>
      <url>https://repo.bluecolored.de/releases/</url>
    </repository>
    <repository>
      <id>dynmap-repo</id>
      <url>https://repo.mikeprimm.com/</url>
    </repository>
  </repositories>

  <profiles>
    <!-- Compiles the module against the Spigot API instead of Paper. Any compile
         error points at a Paper-only API touchpoint that needs a Spigot fallback. -->
    <profile>
      <id>spigot-compat</id>
      <properties>
        <server.api.group>org.spigotmc</server.api.group>
        <server.api.artifact>spigot-api</server.api.artifact>
        <server.api.version>${spigot.version}</server.api.version>
      </properties>
      <repositories>
        <repository>
          <id>spigotmc-repo</id>
          <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
      </repositories>
    </profile>
  </profiles>

  <dependencies>
    <!-- Server API. Paper by default; the spigot-compat profile compiles the same
         sources against the Spigot API to catch any use of Paper-only interfaces.
         Exclude Paper's Adventure 5.x so our shaded/relocated Adventure stays
         self-consistent across Spigot, Paper 1.21.x, and Paper 26.2+. -->
    <dependency>
      <groupId>${server.api.group}</groupId>
      <artifactId>${server.api.artifact}</artifactId>
      <version>${server.api.version}</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>net.kyori</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Vault API (optional economy) via JitPack -->
    <dependency>
      <groupId>com.github.MilkBowl</groupId>
      <artifactId>VaultAPI</artifactId>
      <version>${vault.api.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Shaded & relocated Adventure stack for cross-platform Paper + Spigot support -->
    <dependency>
      <groupId>net.kyori</groupId>
      <artifactId>adventure-api</artifactId>
      <version>${adventure.minimessage.version}</version>
    </dependency>
    <dependency>
      <groupId>net.kyori</groupId>
      <artifactId>adventure-text-minimessage</artifactId>
      <version>${adventure.minimessage.version}</version>
    </dependency>
    <dependency>
      <groupId>net.kyori</groupId>
      <artifactId>adventure-text-serializer-legacy</artifactId>
      <version>${adventure.minimessage.version}</version>
    </dependency>
    <dependency>
      <groupId>net.kyori</groupId>
      <artifactId>adventure-text-serializer-plain</artifactId>
      <version>${adventure.minimessage.version}</version>
    </dependency>

    <dependency>
      <groupId>me.clip</groupId>
      <artifactId>placeholderapi</artifactId>
      <version>2.11.6</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>net.kyori</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.github.castledking</groupId>
      <artifactId>GriefPrevention3D</artifactId>
      <version>${griefprevention3d.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- BlueMap API (optional map integration; only loaded when BlueMap is present) -->
    <dependency>
      <groupId>de.bluecolored</groupId>
      <artifactId>bluemap-api</artifactId>
      <version>2.8.0</version>
      <scope>provided</scope>
    </dependency>
    <!-- Dynmap API (optional map integration; only loaded when Dynmap is present) -->
    <dependency>
      <groupId>us.dynmap</groupId>
      <artifactId>DynmapCoreAPI</artifactId>
      <version>3.8</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>us.dynmap</groupId>
      <artifactId>dynmap-api</artifactId>
      <version>3.8</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>GPExpansion</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <!-- Filtering rewrites bytes, which corrupts a zip. -->
        <excludes>
          <exclude>resourcepack.zip</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <includes>
          <include>resourcepack.zip</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>25</release>
          <compilerArgs>
            <arg>-Xmaxerrs</arg>
            <arg>2000</arg>
            <arg>-Xmaxwarns</arg>
            <arg>2000</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <!--
                    The ResourcePackManager API stub is compile-only. Shipping it would shadow
                    RSPM's real class at runtime and every call would throw.
                  -->
                  <excludes>
                    <exclude>com/magmaguy/**</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/versions/**</exclude>
                    <exclude>org/jetbrains/**</exclude>
                    <exclude>org/intellij/**</exclude>
                    <exclude>org/jspecify/**</exclude>
                    <exclude>com/google/auto/**</exclude>
                    <exclude>com/google/errorprone/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <relocations>
                <relocation>
                  <pattern>net.kyori</pattern>
                  <shadedPattern>codes.castled.gpexpansion.libs.kyori</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
